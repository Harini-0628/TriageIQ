APP_ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY

# Postgres for docker-compose / staging / prod:
# DATABASE_URL=postgresql://triageiq:triageiq@db:5432/triageiq
# SQLite for fast local dev without Docker:
DATABASE_URL=sqlite:///./triageiq_dev.db

ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60

NVD_API_KEY=
LOG_LEVEL=INFO